    "threat_model": {
      "adversary_capabilities": [
        "Target-like spoofing: Attacker crafts transmissions mimicking target transmitter features",
        "Gradual poisoning / creep: Attacker injects incremental malicious drifts to corrupt stored profile",
        "Replay attacks: Attacker retransmits captured legitimate preambles out-of-context",
        "Single-gateway compromise: Attacker controls or deceives a single witnessing gateway"
      ],
      "adversary_limitations": [
        "Attacker cannot simultaneously deceive multiple independent spatially-distributed gateways with consistent multi-angle RF signatures",
        "Attacker cannot alter gateway-to-gateway consensus backhaul"
      ],
      "trust_assumptions": [
        "Majority of witnessing gateways are non-colluding",
        "Profile updates are persistent only when explicitly authorized by the gating contract"
      ]
    },
    "evidence_classification": "Synthetic Controlled Attack Simulation (Not Real Physical RF Attack)"
